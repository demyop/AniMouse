<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="16dp"
            android:text="Название аниме"/>

        <TextView
            android:id="@+id/btnWatching"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="Смотрю"
            android:textColor="@color/turquoise_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnPlanned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="В планах"
            android:textColor="@color/orange_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnCompleted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="Просмотрено"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/btnDropped"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="Брошено"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#339CA3AF"
            android:layout_marginVertical="8dp"/>

        <TextView
            android:id="@+id/btnRemove"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="Удалить из основных списков"
            android:textColor="#EF4444"
            android:textSize="16sp"
            android:background="?attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#339CA3AF"
            android:layout_marginVertical="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Пользовательские списки"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/layoutCustomListsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/btnCreateCustomList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:layout_marginTop="8dp"
            android:text="+ Создать новый список"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>